{
  "hooks": {
    "SessionStart": [{ "matcher": "startup|resume|clear|compact|fork", "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/dist/waypoint.cjs\" hook session-start" }] }],
    "SessionEnd": [{ "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/dist/waypoint.cjs\" hook session-end" }] }],
    "PostToolUse": [
      { "matcher": "Bash", "hooks": [{ "type": "command", "if": "Bash(*git*)", "command": "node \"${CLAUDE_PLUGIN_ROOT}/dist/waypoint.cjs\" hook post-commit" }] },
      { "matcher": "PowerShell", "hooks": [{ "type": "command", "if": "PowerShell(*git*)", "command": "node \"${CLAUDE_PLUGIN_ROOT}/dist/waypoint.cjs\" hook post-commit" }] }
    ],
    "Stop": [{ "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/dist/waypoint.cjs\" hook stop" }] }]
  },
  "modules": ["./register.js"]
}
