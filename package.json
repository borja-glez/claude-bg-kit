{
  "name": "claude-bg-kit",
  "private": true,
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "ci": "node scripts/ci.mjs",
    "typecheck": "tsc --noEmit",
    "typecheck:mod": "tsc -p tsconfig.mod.json",
